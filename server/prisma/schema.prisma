// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────
// Enums
// ──────────────────────────────────────────

enum Role {
  MANAGER
  STAFF
}

enum LocationType {
  INTERNAL
  VENDOR
  CUSTOMER
  ADJUSTMENT
}

enum ContactType {
  SUPPLIER
  CUSTOMER
}

enum OperationType {
  RECEIPT
  DELIVERY
  TRANSFER
  ADJUSTMENT
}

enum OtpPurpose {
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

enum OperationStatus {
  DRAFT
  WAITING
  READY
  DONE
  CANCELLED
}

// ──────────────────────────────────────────
// Models
// ──────────────────────────────────────────

model User {
  id              Int       @id @default(autoincrement())
  loginId         String    @unique @db.VarChar(12)
  email           String    @unique
  passwordHash    String
  fullName        String
  role            Role      @default(STAFF)
  isActive        Boolean   @default(true)
  // Set when the user confirms their email with a sign-up code; unverified users cannot log in
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  otpCodes              OtpCode[]
  responsibleOperations Operation[] @relation("ResponsibleUser")

  @@map("users")
}

model OtpCode {
  id        Int        @id @default(autoincrement())
  userId    Int
  purpose   OtpPurpose @default(PASSWORD_RESET)
  codeHash  String
  expiresAt DateTime
  attempts  Int        @default(0)
  usedAt    DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, purpose])
  @@map("otp_codes")
}

model Warehouse {
  id        Int      @id @default(autoincrement())
  name      String
  shortCode String   @unique
  address   String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  locations          Location[]
  referenceSequences ReferenceSequence[]

  @@map("warehouses")
}

model Location {
  id          Int          @id @default(autoincrement())
  warehouseId Int?
  name        String
  shortCode   String
  fullPath    String       @unique
  type        LocationType
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  warehouse Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  stockQuants      StockQuant[]
  sourceOperations Operation[]  @relation("SourceLocation")
  destOperations   Operation[]  @relation("DestLocation")
  fromStockMoves   StockMove[]  @relation("FromLocation")
  toStockMoves     StockMove[]  @relation("ToLocation")

  @@index([warehouseId])
  @@map("locations")
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@map("categories")
}

model Product {
  id         Int      @id @default(autoincrement())
  name       String
  sku        String   @unique
  categoryId Int
  uom        String
  unitCost   Decimal  @db.Decimal(12, 2)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category       Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  reorderRule    ReorderRule?
  stockQuants    StockQuant[]
  operationLines OperationLine[]
  stockMoves     StockMove[]

  @@index([categoryId])
  @@map("products")
}

model ReorderRule {
  id        Int      @id @default(autoincrement())
  productId Int      @unique
  minQty    Decimal  @db.Decimal(12, 3)
  maxQty    Decimal  @db.Decimal(12, 3)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("reorder_rules")
}

model Contact {
  id        Int         @id @default(autoincrement())
  name      String
  type      ContactType
  email     String?
  phone     String?
  address   String?     @db.Text
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  operations Operation[]

  @@map("contacts")
}

model Operation {
  id               Int             @id @default(autoincrement())
  reference        String          @unique
  type             OperationType
  status           OperationStatus @default(DRAFT)
  contactId        Int?
  sourceLocationId Int
  destLocationId   Int
  scheduleDate     DateTime
  responsibleId    Int
  doneAt           DateTime?
  notes            String?         @db.Text
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  contact        Contact? @relation(fields: [contactId], references: [id], onDelete: Restrict)
  sourceLocation Location @relation("SourceLocation", fields: [sourceLocationId], references: [id], onDelete: Restrict)
  destLocation   Location @relation("DestLocation", fields: [destLocationId], references: [id], onDelete: Restrict)
  responsible    User     @relation("ResponsibleUser", fields: [responsibleId], references: [id], onDelete: Restrict)

  lines      OperationLine[]
  stockMoves StockMove[]

  @@index([type, status])
  @@index([scheduleDate])
  @@index([contactId])
  @@index([sourceLocationId])
  @@index([destLocationId])
  @@index([responsibleId])
  @@map("operations")
}

model OperationLine {
  id          Int      @id @default(autoincrement())
  operationId Int
  productId   Int
  quantity    Decimal  @db.Decimal(12, 3)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  operation Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([operationId])
  @@index([productId])
  @@map("operation_lines")
}

model StockMove {
  id             Int      @id @default(autoincrement())
  operationId    Int
  productId      Int
  fromLocationId Int
  toLocationId   Int
  quantity       Decimal  @db.Decimal(12, 3)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  operation    Operation @relation(fields: [operationId], references: [id], onDelete: Restrict)
  product      Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  fromLocation Location  @relation("FromLocation", fields: [fromLocationId], references: [id], onDelete: Restrict)
  toLocation   Location  @relation("ToLocation", fields: [toLocationId], references: [id], onDelete: Restrict)

  @@index([productId, createdAt])
  @@index([operationId])
  @@index([fromLocationId])
  @@index([toLocationId])
  @@map("stock_moves")
}

model StockQuant {
  id         Int      @id @default(autoincrement())
  productId  Int
  locationId Int
  quantity   Decimal  @default(0) @db.Decimal(12, 3)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  location Location @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([productId, locationId])
  @@index([locationId])
  @@map("stock_quants")
}

model ReferenceSequence {
  id          Int           @id @default(autoincrement())
  warehouseId Int
  type        OperationType
  nextNumber  Int           @default(1)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@unique([warehouseId, type])
  @@map("reference_sequences")
}
