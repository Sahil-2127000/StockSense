// ─── StockSense Prisma Schema (MySQL) ───

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────
// Auth & Users
// ──────────────────────────────────────────

enum Role {
  INVENTORY_MANAGER
  WAREHOUSE_STAFF
}

model User {
  id                String   @id @default(cuid())
  fullName          String
  loginId           String   @unique @db.VarChar(12)
  email             String   @unique
  passwordHash      String
  role              Role     @default(WAREHOUSE_STAFF)
  passwordChangedAt DateTime?
  createdAt         DateTime @default(now())

  refreshTokens     RefreshToken[]
  passwordResetOtps PasswordResetOtp[]
  operations        Operation[]         @relation("ResponsibleUser")
  activityLogs      ActivityLog[]
  notifications     Notification[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String   @db.VarChar(255)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetOtp {
  id         String   @id @default(cuid())
  userId     String
  codeHash   String   @db.VarChar(255)
  expiresAt  DateTime
  lastSentAt DateTime @default(now())
  attempts   Int      @default(0)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_otps")
}

// ──────────────────────────────────────────
// Warehouse & Locations
// ──────────────────────────────────────────

model Warehouse {
  id        String  @id @default(cuid())
  name      String
  shortCode String  @unique @db.VarChar(10)
  address   String? @db.Text
  isDefault Boolean @default(false)
  createdAt DateTime @default(now())

  locations         Location[]
  operations        Operation[]
  referenceCounters ReferenceCounter[]

  @@map("warehouses")
}

model Location {
  id          String @id @default(cuid())
  name        String
  shortCode   String @db.VarChar(20)
  warehouseId String
  fullPath    String @db.VarChar(50)
  createdAt   DateTime @default(now())

  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  stockQuants         StockQuant[]
  operationsAsSource  Operation[]     @relation("SourceLocation")
  operationsAsDest    Operation[]     @relation("DestLocation")
  movesFrom           StockMove[]     @relation("FromLocation")
  movesTo             StockMove[]     @relation("ToLocation")

  @@unique([warehouseId, shortCode])
  @@map("locations")
}

// ──────────────────────────────────────────
// Products & Categories
// ──────────────────────────────────────────

enum UnitOfMeasure {
  UNITS
  KG
  ROLLS
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  createdAt DateTime @default(now())

  products Product[]

  @@map("categories")
}

model Product {
  id         String       @id @default(cuid())
  name       String
  sku        String       @unique @db.VarChar(20)
  categoryId String
  uom        UnitOfMeasure @default(UNITS)
  unitCost   Int          @default(0)
  reorderMin Int          @default(0)
  reorderMax Int          @default(0)
  createdAt  DateTime     @default(now())

  category       Category        @relation(fields: [categoryId], references: [id])
  stockQuants    StockQuant[]
  operationLines OperationLine[]
  stockMoves     StockMove[]

  @@index([categoryId])
  @@map("products")
}

// ──────────────────────────────────────────
// Stock Quants (current stock per location)
// ──────────────────────────────────────────

model StockQuant {
  id         String @id @default(cuid())
  productId  String
  locationId String
  quantity   Decimal @default(0) @db.Decimal(14, 4)

  product  Product  @relation(fields: [productId], references: [id])
  location Location @relation(fields: [locationId], references: [id])

  @@unique([productId, locationId])
  @@map("stock_quants")
}

// ──────────────────────────────────────────
// Contacts (Vendors / Customers)
// ──────────────────────────────────────────

enum ContactType {
  VENDOR
  CUSTOMER
}

model Contact {
  id        String      @id @default(cuid())
  name      String
  type      ContactType
  address   String?     @db.Text
  createdAt DateTime    @default(now())

  operations Operation[]

  @@map("contacts")
}

// ──────────────────────────────────────────
// Reference Counter (auto-numbering)
// ──────────────────────────────────────────

enum OpType {
  IN
  OUT
  INT
  ADJ
}

model ReferenceCounter {
  id          String @id @default(cuid())
  warehouseId String
  opType      OpType
  lastNumber  Int    @default(0)

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([warehouseId, opType])
  @@map("reference_counters")
}

// ──────────────────────────────────────────
// Operations
// ──────────────────────────────────────────

enum OperationType {
  IN
  OUT
  INT
  ADJ
}

enum OperationStatus {
  DRAFT
  WAITING
  READY
  DONE
  CANCELLED
}

model Operation {
  id                String          @id @default(cuid())
  reference         String          @unique @db.VarChar(30)
  type              OperationType
  status            OperationStatus @default(DRAFT)
  warehouseId       String
  contactId         String?
  sourceLocationId  String?
  destLocationId    String?
  scheduledDate     DateTime?
  responsibleUserId String?
  deliveryAddress   String?         @db.Text
  reason            String?
  backorderOfId     String?
  doneAt            DateTime?
  createdAt         DateTime        @default(now())

  warehouse       Warehouse  @relation(fields: [warehouseId], references: [id])
  contact         Contact?   @relation(fields: [contactId], references: [id])
  sourceLocation  Location?  @relation("SourceLocation", fields: [sourceLocationId], references: [id])
  destLocation    Location?  @relation("DestLocation", fields: [destLocationId], references: [id])
  responsibleUser User?      @relation("ResponsibleUser", fields: [responsibleUserId], references: [id])
  backorderOf     Operation? @relation("BackorderChain", fields: [backorderOfId], references: [id])
  backorders      Operation[] @relation("BackorderChain")

  lines        OperationLine[]
  stockMoves   StockMove[]
  activityLogs ActivityLog[]

  @@index([warehouseId])
  @@index([type])
  @@index([status])
  @@index([scheduledDate])
  @@map("operations")
}

model OperationLine {
  id          String  @id @default(cuid())
  operationId String
  productId   String
  quantity    Decimal @db.Decimal(14, 4)
  recordedQty Decimal? @db.Decimal(14, 4)
  countedQty  Decimal? @db.Decimal(14, 4)
  difference  Decimal? @db.Decimal(14, 4)

  operation Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])

  @@index([operationId])
  @@map("operation_lines")
}

// ──────────────────────────────────────────
// Stock Moves (immutable ledger)
// ──────────────────────────────────────────

enum MoveStatus {
  DONE
  CANCELLED
}

model StockMove {
  id              String     @id @default(cuid())
  operationId     String
  reference       String     @db.VarChar(30)
  productId       String
  fromLabel       String?    @db.VarChar(50)
  fromLocationId  String?
  toLabel         String?    @db.VarChar(50)
  toLocationId    String?
  quantity        Decimal    @db.Decimal(14, 4)
  date            DateTime
  status          MoveStatus @default(DONE)

  operation    Operation @relation(fields: [operationId], references: [id])
  product      Product   @relation(fields: [productId], references: [id])
  fromLocation Location? @relation("FromLocation", fields: [fromLocationId], references: [id])
  toLocation   Location? @relation("ToLocation", fields: [toLocationId], references: [id])

  @@index([operationId])
  @@index([productId])
  @@index([date])
  @@map("stock_moves")
}

// ──────────────────────────────────────────
// Activity Log
// ──────────────────────────────────────────

model ActivityLog {
  id          String   @id @default(cuid())
  operationId String
  userId      String?
  message     String   @db.Text
  createdAt   DateTime @default(now())

  operation Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id])

  @@index([operationId])
  @@map("activity_logs")
}

// ──────────────────────────────────────────
// Notifications
// ──────────────────────────────────────────

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String    @db.VarChar(50)
  message   String    @db.Text
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}
