# ── App ──
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ── MySQL ──
DATABASE_URL="mysql://root:password@localhost:3306/stocksense"

# ── JWT ──
JWT_SECRET=dev-jwt-secret-change-in-production-abc123
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production-xyz789
