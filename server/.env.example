# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MySQL + Prisma)
DATABASE_URL="mysql://root:YOUR_PASSWORD@localhost:3306/stocksense"

# Authentication & Security
# Note: JWT_SECRET must be at least 32 characters long
JWT_SECRET="replace_with_a_secure_random_jwt_secret_min_32_characters"
JWT_EXPIRES_IN="7d"

# Client CORS Configuration
CLIENT_URL="http://localhost:5173"

# Email / SMTP Configuration
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER="your_smtp_username"
SMTP_PASS="your_smtp_password"
MAIL_FROM="noreply@stocksense.com"

# Seed data (dev only): password given to the seeded users
SEED_PASSWORD="change_me_Strong@123"
