# ── Server ──
PORT=5000
NODE_ENV=development
# Frontend URL allowed by CORS
CLIENT_URL="http://localhost:5173"

# ── MySQL (Prisma) ──
# Special characters in the password must be URL-encoded (@ → %40, # → %23, / → %2F)
DATABASE_URL="mysql://stocksense:YOUR_PASSWORD@localhost:3306/stocksense"

# ── JWT authentication ──
# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace_with_a_secure_random_jwt_secret_min_32_characters"
JWT_EXPIRES_IN="7d"

# ── Email / SMTP (optional in development: OTP emails are logged to the console) ──
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER="your_smtp_username"
SMTP_PASS="your_smtp_password"
MAIL_FROM="StockSense <noreply@stocksense.com>"

# ── Seed data (development only): password given to the seeded users ──
SEED_PASSWORD="change_me_Strong@123"
